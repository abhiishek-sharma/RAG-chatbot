# LLM provider: "mistral" (default) or "ollama"
LLM_PROVIDER=mistral

# Mistral API key (required when LLM_PROVIDER=mistral)
MISTRAL_API_KEY=your-mistral-api-key-here

# Mistral model (optional, default: mistral-small-latest)
# MISTRAL_MODEL=mistral-small-latest

# Ollama model (optional, default: llama3)
# OLLAMA_MODEL=llama3
